{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mobilezone-zeta.vercel.app"
        }
      ],
      "destination": "https://mobilezone.site/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mobilezone-zeta.vercel.app"
        }
      ],
      "destination": "https://mobilezone.site/:path*",
      "permanent": true
    }
  ]
}
